// Runs once at power-on: the variables every page shares, settings, then
// the first page. P211: after the splash shows briefly, straight into the
// screensaver (the splash has no touch areas - a static image otherwise).
int sys0=0,sys1=0,sys2=0
baud=115200
dim=100
recmod=0
printh 00 00 00 ff ff ff 88 ff ff ff
page 0
delay=2500
page 1
